# Canonical origin used for metadata, sitemap.xml and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://hareendra5555.github.io/portfolio_aug_2026

# Sub-path the site is served from. "/portfolio_aug_2026" for a GitHub Pages
# project site; set to an empty string for a user site or a custom domain.
NEXT_PUBLIC_BASE_PATH=/portfolio_aug_2026

# Optional. Defaults to https://github-contributions-api.jogruber.de
GITHUB_CONTRIBUTIONS_API_URL=

# Optional. Set to 1 to skip build-time link-preview fetches.
SKIP_LINK_PREVIEWS=
